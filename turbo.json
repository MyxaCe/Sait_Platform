{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {}
  },
  "globalDependencies": [
    "docker/**",
    "docker-compose.yml",
    "deploy/vps/docker-compose.yml",
    "apps/*/package.json",
    "packages/*/package.json"
  ]
}
