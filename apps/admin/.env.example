ADMIN_SESSION_SECRET=

# Ключ шифрования секретов 2FA операторов (ТД-013). Генерировать НА СЕРВЕРЕ:
# openssl rand -base64 48. После включения не менять: секреты станут нечитаемыми.
ADMIN_TOTP_KEY=
# 1 — вход по секрету, хранящемуся открытым текстом, запрещён. Включать после
# scripts/encrypt-operator-totp.mjs --apply.
ADMIN_TOTP_REQUIRE_ENCRYPTED=0

DATABASE_URL=

ADMIN_ARGON_MEMORY_KIB=65536
ADMIN_ARGON_TIME=3
ADMIN_ARGON_PARALLELISM=4

ADMIN_BOOTSTRAP_LOGIN=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# Название бренда в шапке админки и в метке 2FA для новых подключений. Пусто — «Центр управления».
ADMIN_BRAND_NAME=
