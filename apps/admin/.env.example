# Центр управления (apps/admin). ШАБЛОН: только имена переменных и способ
# получения значения. Значений здесь нет и не должно появиться — репозиторий
# публичный, пуш это публикация (Р-012).
#
# Локально копируется в .env.local (он в .gitignore).

# ─── Операторская сессия — БЕЗ НЕГО ГЕЙТ ЗАКРЫТ ПО УМОЛЧАНИЮ (Р-394) ─────────
#
# Секрет подписи операторской сессии (HS256). Не задан → ни один токен не
# признаётся валидным, поверхность управления не открывается никому — это
# дефолт, а не поломка. Отдельный от клиентских секретов кабинета (Р-395).
#
# Сгенерировать для разработки (node уже стоит):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#
ADMIN_SESSION_SECRET=

# ─── База платформы ─────────────────────────────────────────────────────────
#
# Postgres платформы (broker_site) — та же база, что у кабинета и сайта
# (Р-395). Нужна для входа (таблица operators), журнала и сида. Без неё вход
# невозможен по определению.
DATABASE_URL=

# ─── Параметры argon2id (Р-451) ─────────────────────────────────────────────
#
# Пароль оператора хешируется argon2id, параметры — ЗДЕСЬ, не в коде. Старт
# консервативный по OWASP (m=64 MiB, t=3, p=4). Усиление параметров подхватит
# прозрачный перехеш при следующем входе. Пусто → умолчания из кода.
ADMIN_ARGON_MEMORY_KIB=65536
ADMIN_ARGON_TIME=3
ADMIN_ARGON_PARALLELISM=4

# ─── Сид первого суперадмина (одноразовый, Р-451) ───────────────────────────
#
# Задаются ТОЛЬКО на время запуска `pnpm --filter @broker/admin seed:admin`.
# Повторный запуск при непустой таблице operators отказывает — сид не бэкдор.
# В постоянном окружении приложения этих переменных быть не должно.
ADMIN_BOOTSTRAP_LOGIN=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
