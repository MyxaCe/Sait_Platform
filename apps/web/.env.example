# Публичный URL сайта — используется в sitemap, robots, OG и JSON-LD
NEXT_PUBLIC_SITE_URL=https://example-broker.com

# Postgres сайта (лиды + outbox, ADR-018). Локально: docker compose up db
# Не задан → in-memory store (только для dev/e2e)
# DATABASE_URL=postgres://broker:broker_dev_password@localhost:5432/broker_site

# URL WebSocket-фида котировок (socket.io).
# Не задан → используется встроенный мок-фид (random walk).
# NEXT_PUBLIC_WS_URL=wss://feed.example-broker.com

# Реальная CMS (отдельная система). Не задан → in-process mock
# с теми же cache-тегами (вебхук-инвалидация работает одинаково)
# CMS_API_URL=https://cms.example-broker.com/v1
# CMS_API_KEY=...

# Секрет HMAC-подписи вебхука POST /api/revalidate (выдаётся CMS)
# CMS_WEBHOOK_SECRET=change-me

# Секрет preview-режима: /api/preview?secret=...&path=... (для редакторов CMS)
# PREVIEW_SECRET=change-me

# Каким сайтом сайт представляется мульти-тенантной CMS.
# Не задан → apex-ru
# SITE_SLUG=apex-ru

# HTTP-адрес MDS: каталог инструментов (какие символы реально стримятся)
# и иконки монет. Не задан → фильтр каталога не применяется, иконок нет.
# MDS_HTTP_URL=https://mds.example-broker.com

# Личный кабинет: куда ведёт кнопка входа в шапке.
# Не задан → http://localhost:3002
# NEXT_PUBLIC_CABINET_URL=https://cabinet.example-broker.com

# Кому разрешено встраивать сайт в iframe (CSP frame-ancestors).
# ВАЖНО: значение фиксируется на СБОРКЕ, а не в рантайме — headers() в Next
# статичны. Для Docker пробрасывается build-arg'ом.
# Не задан → 'self' http://localhost:3001 (вкладка Preview в админке CMS)
# FRAME_ANCESTORS="'self' https://cms.example-broker.com"

# GlitchTip (Sentry). Два разных проекта: браузер и сервер.
# Не заданы → трекер выключен, ошибки только в консоль.
# Грабля: DSN с дефисами в хосте — брать в кавычки (см. docs/).
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ENV / NEXT_PUBLIC_SENTRY_ENV — не заданы → test

# Диагностическая ручка /api/debug/sentry (бросает ошибку с PII).
# Только тестовый контур. Не задан → ручка отвечает 404.
# ALLOW_SENTRY_TEST=1
