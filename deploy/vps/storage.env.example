# Образец storage-env для объектного хранилища KYC (ADM-12, Р-454 II-1).
# Настоящие значения — ТОЛЬКО в /srv/broker/site/.env (chmod 600, не в git).
# Публичный репозиторий: пуш = публикация (Р-012), реальные ключи сюда НИКОГДА.
#
# Имена переменных приложения — ТОЧНО те, что читает
# packages/storage/src/config.ts (loadStorageConfig). readEnv трактует пустую
# строку как «не задано» => fail-closed (StorageNotConfiguredError). Значит
# пустое значение здесь приложение НЕ примет за заданное.
#
# ВРЕМЕННЫЙ вариант стенда: ключи в env. Целевой дом — Vault (ратифицировано).

# --- MinIO root (ТОЛЬКО для админ-операций mc; приложение НЕ использует) ---
MINIO_ROOT_USER=<сгенерировать: напр. standadmin$(openssl rand -hex 4)>
MINIO_ROOT_PASSWORD=<сгенерировать: openssl rand -hex 24>

# --- Контракт приложения (packages/storage) -------------------------------
# ОБЯЗАТЕЛЬНЫЕ:
S3_BUCKET=broker-kyc
S3_ACCESS_KEY_ID=<сгенерировать: openssl rand -hex 10 — ВЫДЕЛЕННЫЙ ключ приложения>
S3_SECRET_ACCESS_KEY=<сгенерировать: openssl rand -hex 20>
# ОПЦИОНАЛЬНЫЕ (значения ниже — рабочие для MinIO на стенде):
#   S3_ENDPOINT      — пусто => AWS S3 по региону; задан => MinIO/прочий S3.
#   S3_REGION        — умолчание us-east-1 (SigV4 требует значение).
#   S3_FORCE_PATH_STYLE — незадан => true, если задан S3_ENDPOINT; иначе 'true'/'false'.
# Эти три в прод-compose заданы прямо в environment сервисов (не секреты):
#   S3_ENDPOINT=http://minio:9000
#   S3_REGION=us-east-1
#   S3_FORCE_PATH_STYLE=true
