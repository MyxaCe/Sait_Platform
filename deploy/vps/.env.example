# Секреты страновой группы (на VPS — рядом с docker-compose.yml, chmod 600).
# В git НЕ коммитить заполненный файл. Это шаблон.
VPS_HOST=203.0.113.10
SITE_DB_PASSWORD=change-me
CMS_DB_PASSWORD=change-me
PAYLOAD_SECRET=change-me-long-random
CMS_API_KEY=change-me
CMS_WEBHOOK_SECRET=change-me
PREVIEW_SECRET=change-me
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
# MDS: ключ Twelve Data (форекс/металлы/акции); пусто — вселенная только Binance
TWELVEDATA_API_KEY=
# Шина платформы: кредл продюсера (site-web), выдаёт платформенная команда
BUS_URL=amqp://site-web:PASSWORD@BUS_HOST:5672/platform
# SSO для терминала: base64 приватного RSA-ключа (пара к JWKS кабинета)
SSO_PRIVATE_KEY_B64=
# GlitchTip DSN'ы (выдаёт платформенная команда): web=клиент(/1), bff=сервер(/2)
# ⚠️ ГРАБЛИ: GlitchTip выдаёт ключ UUID с дефисами, а regex парсера @sentry-JS
# (\w+) дефисы НЕ допускает → «Invalid Sentry Dsn». Убрать дефисы из ключа
# (GlitchTip принимает и такой): 3c8f6268-...-79d → 3c8f62687...79d
SENTRY_DSN_WEB=http://PUBLICKEYNOHYPHENS@GLITCHTIP_HOST:8000/1
SENTRY_DSN_BFF=http://PUBLICKEYNOHYPHENS@GLITCHTIP_HOST:8000/2
# Диагностическая ручка /api/debug/sentry (1 — включить для проверки, потом 0)
ALLOW_SENTRY_TEST=0
